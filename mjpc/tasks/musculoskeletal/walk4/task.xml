  <size memory="40000K"/>
  <custom>
    <!-- agent -->
    <numeric name="agent_planner" data="0" />
    <numeric name="agent_horizon" data="0.3" />
    <numeric name="agent_timestep" data="0.008" />
    <numeric name="sampling_spline_points" data="2 1 10" />
    <!-- <numeric name="sampling_exploration" data="0.1" /> -->
    <numeric name="gradient_spline_points" data="5" />
    <numeric name="residual_Height Goal" data="1.45 0.0 1.6" />
    <numeric name="residual_Velocity Goal" data="1.5 -3 30" />
    <!-- <numeric name="residual_Height Goal" data="1.587 0.0 1.6" /> -->
  </custom>

  <!-- <default>
    <default class="mocap_site">
      <site type="sphere" size="0.027" rgba="0 0 1 1" group="2" material="target"/>
    </default>
  </default> -->

  <worldbody>
    <body name="target[right_foot]" mocap="true" pos="0 -0.5 0">
      <site name="target_site[right_foot]" size="0.027" rgba="0 0 1 1" group="2" material="target"/>
    </body>
    <body name="target[left_foot]" mocap="true" pos="0 0 0">
      <site name="target_site[left_foot]" size="0.027" rgba="1 0 0 1" group="2" material="target"/>
    </body>
    <body name="target[pelvis]" mocap="true" pos="0 0 0">
      <site name="target_site[pelvis]" size="0.027" rgba="1 0 0 1" group="2" material="target"/>
    </body>
  </worldbody>

