<mujoco model="Musculoskeletal">
  <include file="../../common.xml" />
  <!-- modified from: https://github.com/google-deepmind/dm_control/blob/main/dm_control/suite/swimmer.xml -->
  <!-- <include file="swimmer_modified.xml" /> -->
  <include file="../Models/mj_FullBody/mj_fullbody_simple_track.xml"/>
  <!-- <include file="Models/mj_Leg/mj_fullbody_leg.xml"/> -->
 
  <!-- joint actuator -->
  <!-- <include file="Models/mj_Leg/mj_fullbody_leg_motor.xml"/> -->
  <!-- <include file="Models/mj_Leg/80mus_noarm_wrap_motor.xml"/> -->
  <!-- <include file="Models/mj_FullBody/mj_fullbody_simple_motor.xml"/> -->
